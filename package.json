{
  "name": "songlinks",
  "version": "0.2.0",
  "description": "Official TypeScript/JavaScript SDK for the Songlinks API: look up a songwriter by name or IPI name number, or find who wrote a recording by ISRC, and get the person behind every registration, with their works and ISWCs.",
  "keywords": [
    "songlinks",
    "songwriter",
    "music",
    "publishing",
    "ipi",
    "iswc",
    "isrc",
    "credits",
    "metadata",
    "api",
    "sdk",
    "ipi name number",
    "songwriter lookup",
    "isrc lookup",
    "who wrote this song",
    "music publishing",
    "mlc",
    "royalties",
    "typescript"
  ],
  "homepage": "https://songlinks.io/v1/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexkane/songlinks-js.git"
  },
  "bugs": "https://github.com/Alexkane/songlinks-js/issues",
  "license": "MIT",
  "author": "Kane Technology Group, LLC",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "spec:pull": "curl -sf https://songlinks.io/v1/openapi.json -o spec/openapi.json",
    "generate": "mkdir -p .generated && node scripts/clean-spec.mjs spec/openapi.json > .generated/openapi.json && openapi-typescript .generated/openapi.json -o src/schema.ts && node scripts/tidy-schema.mjs src/schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm run docs:check && npm test && npm run build",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "openapi-typescript": "7.4.4",
    "tsup": "8.3.5",
    "typedoc": "0.26.11",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
